{
  "name": "vulcant",
  "version": "0.0.1",
  "port-version": 4,
  "description": "Vulkan rendering and compute abstraction library",
  "homepage": "https://github.com/Liech/Vulcant",
  "license": "MIT",
  "dependencies": [
    "vcpkg-cmake",
    "vcpkg-cmake-config",
    "glm",
    "nlohmann-json",
    "lodepng",
    "vulkan",
    "shaderc",
    "spirv-reflect",
    "glfw3",
    {
      "name": "imgui",
      "features": [
        "glfw-binding",
        "vulkan-binding"
      ]
    }
  ],
  "default-features": [
    "toolkit"
  ],
  "features": {
    "toolkit": {
      "description": "High-level rendering toolkit with scene data, camera, and mesh renderers",
      "dependencies": [
        "shader-slang"
      ]
    }
  }
}
